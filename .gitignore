# ── Credentials ───────────────────────────────────────────────────────────────
# Matched by pattern, not path, so they stay caught if archives move around.
# The pre-commit secret scan is the real backstop; this is the first line.
duetBackup/
*.config.bak
*.pem
*.key
id_rsa*
id_ed25519*
.env

# ── Third-party documentation ─────────────────────────────────────────────────
# Kept locally, linked from the README rather than mirrored into a public repo.
#   gcodes.txt          — Duet3D G-code reference, refresh cmd in CLAUDE.md
#   print_tuning_guide  — Ellis' Print Tuning Guide
gcodes.txt
print_tuning_guide.txt

# ── Upstream slicer source ────────────────────────────────────────────────────
# 161M nested git checkout of oozebot/preFlight at f74dc69 (v1.3.0).
# Re-clonable; pinned commit is recorded in slicer_notes.md.
preFlight/

# ── Backup lock ───────────────────────────────────────────────────────────────
# Pause the watcher to batch a few edits into one commit:
#   echo "reason" > BACKUP_PAUSED   pause, and set the eventual commit subject
#   rm BACKUP_PAUSED                resume; everything lands as ONE commit
# Auto-expires after 10 min if forgotten — see hevort_project_watch.sh.
/BACKUP_PAUSED

# ── Claude Code local settings ──
/.claude/
